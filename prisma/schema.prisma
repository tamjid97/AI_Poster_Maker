datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum PosterStatus {
  DRAFT
  GENERATING
  COMPLETED
  FAILED
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  posters   Poster[]

  @@map("users")
}

model Template {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  slug         String   @unique
  title        String
  occasionType String   @map("occasion_type")
  thumbnailUrl String   @map("thumbnail_url")
  layoutConfig Json     @map("layout_config")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  posters      Poster[]

  @@map("templates")
}

model Poster {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  userId            String       @map("user_id") @db.ObjectId
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId        String?      @map("template_id") @db.ObjectId
  template          Template?    @relation(fields: [templateId], references: [id])
  name              String
  designation       String?
  party             String?
  organization      String?
  unionOrThana      String?      @map("union_or_thana")
  district          String?
  occasion          String
  headline          String
  photoUrls         String[]     @map("photo_urls")
  generatedImageUrl String?      @map("generated_image_url")
  layoutSuggestion  Json?        @map("layout_suggestion")
  status            PosterStatus @default(DRAFT)
  regenerateCount   Int          @default(0) @map("regenerate_count")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@map("posters")
}
